{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shodohq",
  "compatibility_date": "2026-06-20",
  "main": "./workers/app.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "GOOGLE_SHEETS_ENABLED": "true",
    "GOOGLE_SPREADSHEET_ID": "PROD_SPREADSHEET_ID",
    "GOOGLE_SHEET_RANGE": "Form!A:K"
  }
}
